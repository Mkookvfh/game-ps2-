# Native Termux logic smoke test.
# This does not build the PS2 graphics executable.
CC = clang
CFLAGS = -std=gnu11 -O2 -Wall -Wextra -Isrc
LDLIBS = -lm

SOURCES = src/main.c src/player.c src/ai_npc.c src/combat.c
TARGET = game_test

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SOURCES)
	$(CC) $(CFLAGS) $(SOURCES) $(LDLIBS) -o $@

clean:
	rm -f $(TARGET)
